# Copy this file to .env.local and fill in the two values below.
# Both come from the SAME Supabase project the original Diagnostic-Test app
# already uses — find them in the Supabase dashboard under
# Project Settings -> API.
#
# We reuse the anon (public) key on purpose. Every table this app writes to
# has Row Level Security turned on (see db/migrations/0001_init.sql), so the
# anon key can only ever read or write rows that belong to the signed-in
# user. No secret "service role" key is needed anywhere in this app.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Name of the existing table with the real SAT questions in it.
# Defaults to "Practice_Test_Questions" (the table the original app used)
# if you don't set this.
NEXT_PUBLIC_QUESTION_TABLE=Practice_Test_Questions
